{
	"hooks": {
		"PostToolUse": [
			{
				"matcher": "Write|Edit",
				"hooks": [
					{
						"type": "command",
						"command": "\"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/lint-file.sh\"",
						"timeout": 60,
						"statusMessage": "Linting the edited file"
					}
				]
			}
		],
		"Stop": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "\"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/check.sh\"",
						"timeout": 180,
						"statusMessage": "Running svelte-check"
					}
				]
			}
		]
	}
}
